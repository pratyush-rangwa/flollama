# Base URL of the deployed Next.js backend (next/ app) — no trailing slash.
# The mobile app calls {EXPO_PUBLIC_API_BASE_URL}/api/chat and /api/summarize-title.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Firebase "Web client ID" (OAuth 2.0 client, type "Web application") from the
# same Firebase project as next/.env's NEXT_PUBLIC_FIREBASE_* values — required
# by @react-native-google-signin/google-signin to mint an ID token Firebase
# will accept. Get it from Firebase Console > Authentication > Sign-in method
# > Google > Web SDK configuration, or Google Cloud Console > Credentials.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
